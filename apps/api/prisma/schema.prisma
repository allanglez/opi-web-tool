datasource db {
  provider = "sqlserver"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.NVarChar(50)
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id               Int       @id @default(autoincrement())
  externalAuthId   String    @unique @map("external_auth_id") @db.NVarChar(255)
  firstName        String    @map("first_name") @db.NVarChar(100)
  lastName         String    @map("last_name") @db.NVarChar(100)
  email            String    @unique @db.NVarChar(255)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime2
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime2
  statusChangedAt  DateTime? @map("status_changed_at") @db.DateTime2

  userRoles              UserRole[]
  approvedCycles         AssessmentCycle[]      @relation("CycleApprover")
  evaluatorAssignmentsAs EvaluatorAssignment[]  @relation("Evaluator")
  assignedByAssignments  EvaluatorAssignment[]  @relation("AssignedBy")
  assessments            Assessment[]
  assessmentScores       AssessmentScore[]
  assessmentNotes        AssessmentNote[]
  classNotes             ClassNote[]
  audioRecordings        AudioRecording[]
  auditLogs              AssessmentAuditLog[]
  scheduledDates         SchoolAssessmentDate[]
  studentModifications   Student[]              @relation("StudentModifier")
  classSubmissions       ClassSubmission[]
  flaggedReviews         AssessmentReviewFlag[] @relation("FlaggedBy")
  resolvedReviews        AssessmentReviewFlag[] @relation("ResolvedBy")
  manualEdits            ManualEditAuditLog[]   @relation("ManualEditChanger")
  systemAuditLogs        SystemAuditLog[]

  @@index([isActive])
  @@map("users")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AssessmentCycle {
  id             Int       @id @default(autoincrement())
  name           String    @db.NVarChar(100)
  year           Int
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime  @map("ends_on") @db.Date
  isActive       Boolean   @default(false) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime2
  dataApprovedAt DateTime? @map("data_approved_at") @db.DateTime2
  dataApprovedBy Int?      @map("data_approved_by")
  retentionDays  Int?      @map("retention_days")

  approver              User?                  @relation("CycleApprover", fields: [dataApprovedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rounds                AssessmentRound[]
  classes               Class[]
  students              Student[]
  evaluatorAssignments  EvaluatorAssignment[]
  schoolAssessmentDates SchoolAssessmentDate[]
  assessments           Assessment[]

  @@index([isActive])
  @@map("assessment_cycles")
}

model AssessmentRound {
  id          Int      @id @default(autoincrement())
  cycleId     Int      @map("cycle_id")
  roundNumber Int      @map("round_number") @db.TinyInt
  name        String   @db.NVarChar(50)
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  isActive    Boolean  @default(false) @map("is_active")

  cycle                 AssessmentCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessments           Assessment[]
  schoolAssessmentDates SchoolAssessmentDate[]

  @@unique([cycleId, roundNumber])
  @@map("assessment_rounds")
}

model Program {
  id      Int     @id @default(autoincrement())
  name    String  @unique @db.NVarChar(100)
  code    String  @unique @db.NVarChar(50)
  opiType String? @map("opi_type") @db.NVarChar(100)
  classes Class[]

  @@map("programs")
}

model School {
  id           Int     @id @default(autoincrement())
  schoolCode   String  @unique @map("school_code") @db.NVarChar(50)
  name         String  @db.NVarChar(255)
  district     String? @db.NVarChar(100)
  schoolType   String? @map("school_type") @db.NVarChar(50)
  contactName  String? @map("contact_name") @db.NVarChar(255)
  contactEmail String? @map("contact_email") @db.NVarChar(255)
  contactPhone String? @map("contact_phone") @db.NVarChar(50)

  classes               Class[]
  students              Student[]
  schoolAssessmentDates SchoolAssessmentDate[]

  @@map("schools")
}

model Class {
  id               Int     @id @default(autoincrement())
  cycleId          Int     @map("cycle_id")
  schoolId         Int     @map("school_id")
  programId        Int?    @map("program_id")
  classCode        String  @map("class_code") @db.NVarChar(50)
  courseTitle      String? @map("course_title") @db.NVarChar(255)
  grade            Int?
  teacherId        Int?    @map("teacher_id")
  semesterTerm     String? @map("semester_term") @db.NVarChar(10)
  isActive         Boolean @default(true) @map("is_active")
  isIncluded       Boolean @default(true) @map("is_included")
  isManuallyEdited Boolean @default(false) @map("is_manually_edited")
  roomNumber       String? @map("room_number") @db.NVarChar(50)

  cycle                AssessmentCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  school               School                @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  program              Program?              @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classStudents        ClassStudent[]
  evaluatorAssignments EvaluatorAssignment[]
  classNotes           ClassNote[]
  classSubmissions     ClassSubmission[]

  @@index([cycleId, schoolId])
  @@index([cycleId, isIncluded])
  @@map("classes")
}

model Student {
  id               Int       @id @default(autoincrement())
  cycleId          Int       @map("cycle_id")
  schoolId         Int       @map("school_id")
  studentNumber    String    @map("student_number") @db.NVarChar(50)
  aspenStudentId   String?   @map("aspen_student_id") @db.NVarChar(50)
  firstName        String    @map("first_name") @db.NVarChar(100)
  lastName         String    @map("last_name") @db.NVarChar(100)
  middleName       String?   @map("middle_name") @db.NVarChar(100)
  pen              String?   @db.NVarChar(50)
  grade            Int?
  isActive         Boolean   @default(true) @map("is_active")
  isManuallyEdited Boolean   @default(false) @map("is_manually_edited")
  lastModifiedBy   Int?      @map("last_modified_by")
  lastModifiedAt   DateTime? @map("last_modified_at") @db.DateTime2

  cycle         AssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  school        School          @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modifier      User?           @relation("StudentModifier", fields: [lastModifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classStudents ClassStudent[]
  assessments   Assessment[]

  @@unique([cycleId, studentNumber])
  @@map("students")
}

model ClassStudent {
  classId   Int @map("class_id")
  studentId Int @map("student_id")

  class   Class   @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([classId, studentId])
  @@map("class_students")
}

model EvaluatorAssignment {
  id          Int      @id @default(autoincrement())
  cycleId     Int      @map("cycle_id")
  classId     Int      @map("class_id")
  evaluatorId Int      @map("evaluator_id")
  assignedBy  Int      @map("assigned_by")
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.DateTime2

  cycle     AssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  class     Class           @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluator User            @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigner  User            @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cycleId, classId, evaluatorId])
  @@map("evaluator_assignments")
}

model SchoolAssessmentDate {
  id             Int      @id @default(autoincrement())
  cycleId        Int      @map("cycle_id")
  roundId        Int?     @map("round_id")
  schoolId       Int      @map("school_id")
  assessmentDate DateTime @map("assessment_date") @db.Date
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime2

  cycle   AssessmentCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  round   AssessmentRound? @relation(fields: [roundId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school  School           @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User             @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cycleId, roundId, schoolId, assessmentDate])
  @@map("school_assessment_dates")
}

model Assessment {
  id                 Int       @id @default(autoincrement())
  cycleId            Int       @map("cycle_id")
  roundId            Int?      @map("round_id")
  studentId          Int       @map("student_id")
  evaluatorId        Int?      @map("evaluator_id")
  status             String    @default("NOT_STARTED") @db.NVarChar(20)
  needsReview        Boolean   @default(false) @map("needs_review")
  startedAt          DateTime? @map("started_at") @db.DateTime2
  completedAt        DateTime? @map("completed_at") @db.DateTime2
  lastModifiedAt     DateTime  @default(now()) @map("last_modified_at") @db.DateTime2
  submittedAt        DateTime? @map("submitted_at") @db.DateTime2
  classSubmissionId  Int?      @map("class_submission_id")

  cycle           AssessmentCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  round           AssessmentRound?           @relation(fields: [roundId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student                    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluator       User?                      @relation(fields: [evaluatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classSubmission ClassSubmission?           @relation(fields: [classSubmissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  score           AssessmentScore?
  notes           AssessmentNote[]
  audioRecordings AudioRecording[]
  auditLogs       AssessmentAuditLog[]
  criteriaResults AssessmentCriteriaResult[]
  reviewFlags     AssessmentReviewFlag[]

  @@unique([cycleId, studentId])
  @@index([cycleId, status])
  @@index([evaluatorId, status])
  @@index([needsReview])
  @@map("assessments")
}

model OpiLevel {
  id          Int    @id @map("level")
  description String @db.NVarChar(255)

  criteria AssessmentCriteria[]
  scores   AssessmentScore[]

  @@map("opi_levels")
}

model AssessmentScore {
  assessmentId Int      @id @map("assessment_id")
  opiLevelId   Int      @map("opi_level_id")
  notes        String?  @db.NVarChar(Max)
  updatedBy    Int      @map("updated_by")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.DateTime2

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  opiLevel   OpiLevel   @relation(fields: [opiLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater    User       @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("assessment_scores")
}

model AssessmentCriteria {
  id          Int     @id @default(autoincrement())
  opiLevelId  Int     @map("opi_level_id")
  description String  @db.NVarChar(255)
  isActive    Boolean @default(true) @map("is_active")

  opiLevel OpiLevel                   @relation(fields: [opiLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  results  AssessmentCriteriaResult[]

  @@map("assessment_criteria")
}

model AssessmentCriteriaResult {
  assessmentId Int     @map("assessment_id")
  criteriaId   Int     @map("criteria_id")
  met          Boolean

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  criteria   AssessmentCriteria @relation(fields: [criteriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assessmentId, criteriaId])
  @@map("assessment_criteria_results")
}

model AssessmentNote {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  note         String   @db.NVarChar(Max)
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime2

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator    User       @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("assessment_notes")
}

model ClassNote {
  id        Int      @id @default(autoincrement())
  classId   Int      @map("class_id")
  note      String   @db.NVarChar(Max)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime2

  class  Class @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User  @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([classId])
  @@map("class_notes")
}

model AudioRecording {
  id              Int      @id @default(autoincrement())
  assessmentId    Int      @map("assessment_id")
  storageProvider String   @map("storage_provider") @db.NVarChar(50)
  storageKey      String   @map("storage_key") @db.NVarChar(512)
  fileName        String   @map("file_name") @db.NVarChar(255)
  mimeType        String   @map("mime_type") @db.NVarChar(100)
  fileSizeBytes   BigInt   @map("file_size_bytes")
  durationSeconds Int?     @map("duration_seconds")
  uploadedBy      Int      @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.DateTime2

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploader   User       @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assessmentId, uploadedAt])
  @@map("audio_recordings")
}

model AssessmentAuditLog {
  id           Int      @id @default(autoincrement())
  assessmentId Int      @map("assessment_id")
  action       String   @db.NVarChar(50)
  fieldName    String?  @map("field_name") @db.NVarChar(100)
  oldValue     String?  @map("old_value") @db.NVarChar(255)
  newValue     String?  @map("new_value") @db.NVarChar(255)
  changedBy    Int      @map("changed_by")
  changedAt    DateTime @default(now()) @map("changed_at") @db.DateTime2

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changer    User       @relation(fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("assessment_audit_log")
}

model ManualEditAuditLog {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type") @db.NVarChar(50)
  entityId   Int      @map("entity_id")
  action     String   @db.NVarChar(50)
  fieldName  String?  @map("field_name") @db.NVarChar(100)
  oldValue   String?  @map("old_value") @db.NVarChar(500)
  newValue   String?  @map("new_value") @db.NVarChar(500)
  changedBy  Int      @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at") @db.DateTime2

  changer User @relation("ManualEditChanger", fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("manual_edit_audit_log")
}

model IngestionLog {
  id              Int      @id @default(autoincrement())
  entityType      String   @map("entity_type") @db.NVarChar(50)
  recordsTotal    Int      @map("records_total")
  recordsUpserted Int      @map("records_upserted")
  recordsFailed   Int      @map("records_failed")
  errors          String?  @db.NVarChar(Max)
  idempotencyKey  String?  @map("idempotency_key") @db.NVarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime2

  @@map("ingestion_logs")
}

model Teacher {
  id        Int     @id @default(autoincrement())
  teacherId String  @unique @map("teacher_id") @db.NVarChar(50)
  name      String  @db.NVarChar(255)
  classes   Class[]

  @@map("teachers")
}

model ClassSubmission {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  submittedBy Int       @map("submitted_by")
  submittedAt DateTime  @map("submitted_at") @db.DateTime2
  status      String    @default("SUBMITTED") @db.NVarChar(20)
  notes       String?   @db.NVarChar(Max)

  class       Class       @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submitter   User        @relation(fields: [submittedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments Assessment[]

  @@index([classId])
  @@index([submittedBy])
  @@index([status])
  @@map("class_submissions")
}

model AssessmentReviewFlag {
  id              Int       @id @default(autoincrement())
  assessmentId    Int       @map("assessment_id")
  flaggedBy       Int       @map("flagged_by")
  reason          String?   @db.NVarChar(Max)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2
  resolvedAt      DateTime? @map("resolved_at") @db.DateTime2
  resolvedBy      Int?      @map("resolved_by")
  resolutionNotes String?   @map("resolution_notes") @db.NVarChar(Max)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  flagger    User       @relation("FlaggedBy", fields: [flaggedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolver   User?      @relation("ResolvedBy", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assessmentId])
  @@index([flaggedBy])
  @@index([resolvedAt])
  @@map("assessment_review_flags")
}

model DataWarehouseBatch {
  id           Int       @id @default(autoincrement())
  status       String    @default("PENDING") @db.NVarChar(20) // PENDING, SEEDING, SEEDED, FAILED
  recordCount  Int       @map("record_count")
  targetYear   Int       @map("target_year")
  receivedAt   DateTime  @default(now()) @map("received_at") @db.DateTime2
  seededAt     DateTime? @map("seeded_at") @db.DateTime2
  errorMessage String?   @map("error_message") @db.NVarChar(Max)

  records DataWarehouseStagingRecord[]

  @@index([status])
  @@map("data_warehouse_batches")
}

model DataWarehouseStagingRecord {
  id                 Int    @id @default(autoincrement())
  batchId            Int    @map("batch_id")
  opiType            String @map("opi_type") @db.NVarChar(100)
  schoolNumber       String @map("school_number") @db.NVarChar(50)
  schoolName         String @map("school_name") @db.NVarChar(255)
  schoolType         String? @map("school_type") @db.NVarChar(50)
  schoolYear         Int    @map("school_year")
  studentNumber      String @map("student_number") @db.NVarChar(50)
  pen                String? @db.NVarChar(50)
  studentLastName    String @map("student_last_name") @db.NVarChar(100)
  studentFirstName   String @map("student_first_name") @db.NVarChar(100)
  studentMiddleName  String? @map("student_middle_name") @db.NVarChar(100)
  grade              Int
  course             String @db.NVarChar(50)
  courseTitle         String @map("course_title") @db.NVarChar(255)
  teacherId          String @map("teacher_id") @db.NVarChar(50)
  teacherName        String @map("teacher_name") @db.NVarChar(255)
  semesterTerm       String @map("semester_term") @db.NVarChar(10)
  programCode        String @map("program_code") @db.NVarChar(50)
  programDescription String @map("program_description") @db.NVarChar(255)

  batch DataWarehouseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([batchId])
  @@map("data_warehouse_staging_records")
}

model SystemAuditLog {
  id                Int      @id @default(autoincrement())
  action            String   @db.NVarChar(50)
  cycleId           Int?     @map("cycle_id")
  cycleName         String?  @map("cycle_name") @db.NVarChar(100)
  cycleYear         Int?     @map("cycle_year")
  performedBy       Int      @map("performed_by")
  purgedAssessments Int?     @map("purged_assessments")
  purgedStudents    Int?     @map("purged_students")
  purgedAudioFiles  Int?     @map("purged_audio_files")
  details           String?  @db.NVarChar(Max)
  performedAt       DateTime @default(now()) @map("performed_at") @db.DateTime2

  performer User @relation(fields: [performedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action])
  @@index([performedAt])
  @@map("system_audit_log")
}
