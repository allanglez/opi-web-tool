    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/schedule": "^4.0.0",
    "@prisma/client": "^5.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jwks-rsa": "^3.1.0",
    "class-validator": "^0.14.1",
