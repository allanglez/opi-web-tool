# Database (DATABASE_URL for Prisma migrations, individual vars for runtime adapter)
DATABASE_URL="sqlserver://localhost:1433;database=opi;user=sa;password=YourPassword;encrypt=false;trustServerCertificate=true"
DB_HOST="localhost"
DB_PORT="1433"
DB_NAME="opi"
DB_USER="sa"
DB_PASSWORD="YourPassword"
DB_ENCRYPT="false"
DB_TRUST_CERT="true"

# Auth0 (JWT validation)
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_AUDIENCE="opi-api"
AUTH0_ISSUER="https://your-tenant.us.auth0.com/"

# Mock Auth (dev only - set to true to use X-Mock-User-Id header instead of JWT)
AUTH_MOCK=true

# Audio Storage
AUDIO_STORAGE_PROVIDER="minio"
AUDIO_STORAGE_PATH="./audio-storage"
MAX_AUDIO_MB="50"

# S3 / MinIO Audio Storage (used when AUDIO_STORAGE_PROVIDER is "s3" or "minio")
AUDIO_S3_BUCKET="opi-audio"
AUDIO_S3_REGION="us-east-1"
AUDIO_S3_ENDPOINT="http://localhost:9000"
AUDIO_S3_FORCE_PATH_STYLE="true"
AUDIO_S3_ACCESS_KEY_ID="minioadmin"
AUDIO_S3_SECRET_ACCESS_KEY="minioadmin"
AUDIO_S3_SIGNED_URL_EXPIRES_SECONDS="3600"

# Server
PORT=3000
NODE_ENV=development
