# Frontend auth mode: "mock" for local role simulation, "auth0" for real Auth0 login.
VITE_AUTH_MODE=mock

# API base URL (both keys are supported by the app).
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Auth0 SPA app settings example:
# - Allowed Callback URLs: http://localhost:5173/auth/callback
# - Allowed Logout URLs: http://localhost:5173/login,http://localhost:5173
# - Allowed Web Origins: http://localhost:5173
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://opi-api
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/auth/callback
